# TfL Unified API credentials (register at https://api-portal.tfl.gov.uk/)
# Many TfL endpoints work unauthenticated at low rate limits; set these for
# higher limits / production ingestion.
TFL_APP_ID=
TFL_APP_KEY=

# AWS — prefer a configured AWS CLI profile over static keys.
# Leave AWS_PROFILE set and omit the key/secret vars where possible.
AWS_PROFILE=default
AWS_REGION=eu-west-2
S3_BUCKET=

# Populated once the dbt project targets Athena
ATHENA_DATABASE=
ATHENA_OUTPUT_LOCATION=
