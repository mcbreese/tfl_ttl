# Copy to .env and fill in. .env is gitignored; this file is committed.
# In GitHub Actions, set these as repository secrets/variables instead.

# Required: bucket the raw polls land in.
S3_BUCKET=

# Optional: shown values are the defaults in src/tfl_ttl/config.py.
S3_PREFIX=raw/tfl
AWS_REGION=eu-west-2

# Optional but recommended: without it, TfL requests are unauthenticated and
# rate-limited harder. Register at https://api-portal.tfl.gov.uk/
TFL_APP_KEY=

# AWS credentials are not set here. boto3 finds them itself. Don't add
# AWS_PROFILE unless that profile exists in your ~/.aws/config.
