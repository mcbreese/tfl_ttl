# Copy to .env and fill in. .env is gitignored; this file is committed.
# In GitHub Actions, these come from repository secrets/variables instead.

# AWS credentials are NOT set here. They live as named profiles in
# ~/.aws/credentials (outside every repo); this picks the one used for uploads.
# The profile must exist, or boto3 raises ProfileNotFound.
AWS_PROFILE=raw-writer

# Required: bucket the raw polls land in.
S3_BUCKET=

# Optional: shown value is the default in src/tfl_ttl/config.py. Use
# raw/tfl_verify for test polls (emptied by a lifecycle rule after 7 days).
S3_PREFIX=raw/tfl

# Optional: without it, TfL requests are anonymous, which is fine at this
# volume. Register at https://api-portal.tfl.gov.uk/
TFL_APP_KEY=
